  "info": {
    "description": "API REST JSON para productos y sub\u00f3rdenes de comerciantes externos bajo `/api/merchant_store/`. Autenticaci\u00f3n con la clave de dispositivo de Tienda Apk (Bearer). La compa\u00f1\u00eda es la del dispositivo; estas rutas no leen `X-Company-Slug`.",
    "title": "API Comercios",
    "version": "19.0.1.9.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/merchant_store/checkouts": {
      "post": {
        "description": "Crea una suborden por cada comerciante presente en `lines`. Idempotente por `client_checkout_id`: reutilizar el mismo identificador en reintentos devuelve las sub\u00f3rdenes ya creadas sin duplicarlas.",
        "operationId": "merchant_store_checkouts_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutCreateBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
