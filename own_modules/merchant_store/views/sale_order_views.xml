<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_merchant_store_sale_order_list" model="ir.ui.view">
        <field name="name">sale.order.list.merchant.store</field>
        <field name="model">sale.order</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Pedidos de comerciantes">
                <field name="name"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="merchant_id"/>
                <field name="client_checkout_id" optional="show" readonly="1"/>
                <field name="order_bridge_order_id" optional="hide" readonly="1"/>
                <field
                    name="order_bridge_store_state"
                    widget="badge"
                    decoration-muted="order_bridge_store_state == 'reviewing'"
                    decoration-warning="order_bridge_store_state == 'negotiating'"
                    decoration-info="order_bridge_store_state == 'ready_for_delivery'"
                    decoration-success="order_bridge_store_state == 'delivered'"
                    decoration-danger="order_bridge_store_state == 'canceled'"/>
                <field name="amount_total" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="state" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_merchant_store_sale_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.merchant.store</field>
        <field name="model">sale.order</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Pedido de comerciante">
                <header>
                    <button
                        name="action_order_bridge_negotiate"
                        string="Negociar"
                        type="object"
                        class="btn-warning"
                        groups="sales_team.group_sale_salesman"
                        invisible="order_bridge_store_state != 'reviewing'"
                    />
                    <button
                        name="action_order_bridge_ready_for_delivery"
                        string="Listo para la entrega"
                        type="object"
                        class="btn-info"
                        groups="sales_team.group_sale_salesman"
                        invisible="order_bridge_store_state not in ('reviewing', 'negotiating')"
                    />
                    <button
                        name="action_order_bridge_delivered"
                        string="Entregado"
                        type="object"
                        class="btn-success"
                        groups="sales_team.group_sale_salesman"
                        invisible="order_bridge_store_state != 'ready_for_delivery'"
                    />
                    <button
                        name="action_order_bridge_cancel_store"
                        string="Cancelar"
                        type="object"
                        class="btn-danger"
                        groups="sales_team.group_sale_salesman"
                        invisible="order_bridge_store_state not in ('reviewing', 'negotiating', 'ready_for_delivery', 'delivered')"
                    />
                    <field
                        name="order_bridge_store_state"
                        widget="statusbar"
                        statusbar_visible="reviewing,negotiating,ready_for_delivery,delivered,canceled"
                        groups="sales_team.group_sale_salesman"
                    />
                    <field name="state" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="merchant_id" required="1"
                                domain="[('company_id', 'in', allowed_company_ids)]"/>
                            <field name="partner_id" required="1"/>
                            <field name="date_order"/>
                        </group>
                        <group>
                            <field name="client_checkout_id" readonly="1"/>
                            <field name="order_bridge_order_id" readonly="1"/>
                            <field name="company_id" groups="!base.group_multi_company" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="pricelist_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas" name="order_lines">
                            <field name="order_line">
                                <list editable="bottom">
                                    <field name="product_id"
                                        domain="[('product_tmpl_id.merchant_id', '=', parent.merchant_id)]"
                                        required="1"/>
                                    <field name="name"/>
                                    <field name="product_uom_qty"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal" sum="Subtotal"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" colspan="2">
                                <field name="amount_untaxed"/>
                                <field name="amount_tax"/>
                                <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                    <label for="amount_total"/>
                                </div>
                                <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_merchant_store_sale_order" model="ir.actions.act_window">
        <field name="name">Pedidos</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('merchant_id', '!=', False)]</field>
        <field name="context">{}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_merchant_store_sale_order_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_merchant_store_sale_order_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree el primer pedido de un comerciante.
            </p>
        </field>
    </record>

    <!-- Exclude merchant suborders from business Sales menus -->
    <record id="sale.action_orders" model="ir.actions.act_window">
        <field name="domain">[('merchant_id', '=', False)]</field>
    </record>

    <record id="sale.action_quotations" model="ir.actions.act_window">
        <field name="domain">[('merchant_id', '=', False)]</field>
    </record>

    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="domain">[('merchant_id', '=', False)]</field>
    </record>
</odoo>
