<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_merchant_store_merchant_list" model="ir.ui.view">
        <field name="name">merchant_store.merchant.list</field>
        <field name="model">merchant_store.merchant</field>
        <field name="arch" type="xml">
            <list string="Comerciantes">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_merchant_store_merchant_form" model="ir.ui.view">
        <field name="name">merchant_store.merchant.form</field>
        <field name="model">merchant_store.merchant</field>
        <field name="arch" type="xml">
            <form string="Comerciante">
                <sheet>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nombre del comerciante"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_merchant_store_merchant" model="ir.actions.act_window">
        <field name="name">Comerciantes</field>
        <field name="res_model">merchant_store.merchant</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree el primer comerciante externo de esta tienda.
            </p>
        </field>
    </record>
</odoo>
