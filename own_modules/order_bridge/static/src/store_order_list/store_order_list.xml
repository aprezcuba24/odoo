<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="order_bridge.StoreOrderListView" t-inherit="web.ListView" t-inherit-mode="primary"/>

    <t t-name="order_bridge.StoreOrderListView.Buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="primary">
        <xpath expr="." position="inside">
            <button
                t-if="!prepareMessaging.active"
                type="button"
                class="btn btn-primary"
                t-att-disabled="prepareMessaging.selecting"
                t-on-click="onPrepareMessaging"
            >
                Preparar Mensajería
            </button>
            <button
                t-if="prepareMessaging.active"
                type="button"
                class="btn btn-success"
                t-att-disabled="prepareMessaging.generating or prepareMessaging.selecting"
                t-on-click="onDownloadMessagingGuide"
            >
                <t t-if="prepareMessaging.generating">Generando…</t>
                <t t-else="">Generar PDF y Poner "Listo para entrega"</t>
            </button>
            <button
                t-if="prepareMessaging.active"
                type="button"
                class="btn btn-secondary"
                t-att-disabled="prepareMessaging.generating"
                t-on-click="onCancelPrepareMessaging"
            >
                Cancelar
            </button>
        </xpath>
    </t>
</templates>
