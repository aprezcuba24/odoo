<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_bridge_assign_messenger_wizard_form" model="ir.ui.view">
        <field name="name">order_bridge.assign.messenger.wizard.form</field>
        <field name="model">order_bridge.assign.messenger.wizard</field>
        <field name="arch" type="xml">
            <form string="Asignar mensajero">
                <group>
                    <field name="order_count" readonly="1"/>
                    <field name="company_id" invisible="1"/>
                    <field
                        name="messenger_id"
                        options="{'no_create': True}"
                        domain="[('active', '=', True)]"
                    />
                    <field name="order_ids" invisible="1"/>
                </group>
                <footer>
                    <button
                        name="action_assign"
                        string="Asignar"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_order_bridge_assign_messenger_wizard" model="ir.actions.act_window">
        <field name="name">Asignar mensajero</field>
        <field name="res_model">order_bridge.assign.messenger.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_order_bridge_assign_messenger_wizard_form"/>
    </record>
</odoo>
