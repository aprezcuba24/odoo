<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_bridge_payment_method_tree" model="ir.ui.view">
        <field name="name">order_bridge.payment.method.list</field>
        <field name="model">order_bridge.payment.method</field>
        <field name="arch" type="xml">
            <list string="Vías de pago">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean"/>
            </list>
        </field>
    </record>

    <record id="view_order_bridge_payment_method_form" model="ir.ui.view">
        <field name="name">order_bridge.payment.method.form</field>
        <field name="model">order_bridge.payment.method</field>
        <field name="arch" type="xml">
            <form string="Vía de pago">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_order_bridge_payment_method_search" model="ir.ui.view">
        <field name="name">order_bridge.payment.method.search</field>
        <field name="model">order_bridge.payment.method</field>
        <field name="arch" type="xml">
            <search string="Vías de pago">
                <field name="name"/>
                <filter name="active" string="Activos" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archivados" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_order_bridge_payment_method" model="ir.actions.act_window">
        <field name="name">Vías de pago</field>
        <field name="res_model">order_bridge.payment.method</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_order_bridge_payment_method_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Defina las vías de pago para cobros de pedidos Tienda Apk.</p>
        </field>
    </record>
</odoo>
