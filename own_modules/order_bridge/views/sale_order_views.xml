<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_order_bridge" model="ir.ui.view">
        <field name="name">sale.order.form.order.bridge</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@id='create_invoice']" position="attributes">
                <attribute name="invisible">invoice_status != 'to invoice' and not order_bridge_origin</attribute>
                <attribute name="string">Crear factura</attribute>
            </xpath>
            <xpath expr="//header/button[@id='create_invoice_percentage']" position="attributes">
                <attribute name="invisible">order_bridge_origin or invoice_status != 'no' or state != 'sale'</attribute>
                <attribute name="string">Crear factura</attribute>
            </xpath>
            <xpath expr="//header/button[@id='quotation_send_primary']" position="attributes">
                <attribute name="invisible">order_bridge_origin or state != 'draft'</attribute>
                <attribute name="string">Enviar</attribute>
            </xpath>
            <xpath expr="//header/button[@id='quotation_send']" position="attributes">
                <attribute name="invisible">order_bridge_origin or state not in ('sent', 'sale')</attribute>
                <attribute name="string">Enviar</attribute>
            </xpath>
            <xpath expr="//header/button[@id='send_proforma_primary']" position="attributes">
                <attribute name="invisible">order_bridge_origin or state != 'draft' or invoice_count &gt;= 1</attribute>
            </xpath>
            <xpath expr="//header/button[@id='send_proforma']" position="attributes">
                <attribute name="invisible">order_bridge_origin or state == 'draft' or invoice_count &gt;= 1</attribute>
            </xpath>
            <xpath expr="//header/button[@id='action_confirm']" position="attributes">
                <attribute name="invisible">order_bridge_origin or state != 'sent'</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_confirm'][not(@id)]" position="attributes">
                <attribute name="invisible">order_bridge_origin or state != 'draft'</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_draft']" position="attributes">
                <attribute name="invisible">order_bridge_origin or state != 'cancel'</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_preview_sale_order']" position="attributes">
                <attribute name="string">Vista previa</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">order_bridge_origin or state not in ('draft', 'sent', 'sale') or not id or locked</attribute>
            </xpath>
            <xpath expr="//header/field[@name='state'][@widget='statusbar']" position="attributes">
                <attribute name="invisible">order_bridge_origin</attribute>
            </xpath>
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="order_bridge_origin" invisible="1" force_save="1"/>
                <button
                    name="action_order_bridge_negotiate"
                    string="Negociar"
                    type="object"
                    class="btn-warning"
                    groups="sales_team.group_sale_salesman"
                    invisible="not order_bridge_origin or order_bridge_store_state != 'reviewing'"
                />
                <button
                    name="action_order_bridge_ready_for_delivery"
                    string="Listo para la entrega"
                    type="object"
                    class="btn-info"
                    groups="sales_team.group_sale_salesman"
                    invisible="not order_bridge_origin or order_bridge_store_state not in ('reviewing', 'negotiating')"
                />
                <button
                    name="action_order_bridge_delivered"
                    string="Entregado"
                    type="object"
                    class="btn-success"
                    groups="sales_team.group_sale_salesman"
                    invisible="not order_bridge_origin or order_bridge_store_state != 'ready_for_delivery'"
                />
                <button
                    name="action_order_bridge_cancel_store"
                    string="Cancelar"
                    type="object"
                    class="btn-danger"
                    groups="sales_team.group_sale_salesman"
                    invisible="not order_bridge_origin or order_bridge_store_state not in ('reviewing', 'negotiating', 'ready_for_delivery', 'delivered')"
                />
                <field
                    name="order_bridge_store_state"
                    widget="statusbar"
                    statusbar_visible="reviewing,negotiating,ready_for_delivery,delivered,canceled"
                    groups="sales_team.group_sale_salesman"
                    invisible="not order_bridge_origin"
                />
            </xpath>
            <xpath expr="//group[@name='sale_header']" position="after">
                <group
                    name="order_bridge_info"
                    string="Tienda Apk"
                    groups="sales_team.group_sale_salesman"
                    invisible="not order_bridge_origin"
                >
                    <field
                        name="order_bridge_store_state"
                        widget="badge"
                        decoration-muted="order_bridge_store_state == 'reviewing'"
                        decoration-warning="order_bridge_store_state == 'negotiating'"
                        decoration-info="order_bridge_store_state == 'ready_for_delivery'"
                        decoration-success="order_bridge_store_state == 'delivered'"
                        decoration-danger="order_bridge_store_state == 'canceled'"
                    />
                    <div invisible="order_bridge_origin != 'app'" colspan="2" class="text-muted">
                        Compra realizada desde la APK.
                    </div>
                    <div invisible="order_bridge_origin != 'admin'" colspan="2" class="text-muted">
                        Pedido creado por el administrador.
                    </div>
                    <field name="order_bridge_ref" readonly="1"/>
                    <field name="order_bridge_client_order_id" readonly="1" optional="hide"/>
                    <field name="order_bridge_device_id" options="{'no_create': True}"/>
                    <field name="order_bridge_device_phone_validated" readonly="1"/>
                    <field
                        name="order_bridge_messenger_id"
                        options="{'no_create': True}"
                    />
                    <field
                        name="order_bridge_unread_messenger_note"
                        widget="boolean"
                        readonly="1"
                        invisible="not order_bridge_unread_messenger_note"
                    />
                    <button
                        name="action_order_bridge_mark_messenger_notes_reviewed"
                        string="Marcar notas del mensajero como revisadas"
                        type="object"
                        class="btn-secondary"
                        groups="sales_team.group_sale_salesman"
                        invisible="not order_bridge_unread_messenger_note"
                        colspan="2"
                    />
                    <field
                        name="order_bridge_delivery_received_at"
                        readonly="1"
                        invisible="not order_bridge_delivery_received_at"
                    />
                    <field
                        name="order_bridge_delivery_device_at"
                        readonly="1"
                        invisible="not order_bridge_delivery_device_at"
                    />
                    <field name="order_bridge_snapshot_address_id" readonly="1" invisible="not order_bridge_snapshot_address_id" options="{'no_create': True}"/>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page
                    string="Notas de entrega"
                    name="order_bridge_delivery_notes"
                    groups="sales_team.group_sale_salesman"
                    invisible="not order_bridge_origin"
                >
                    <field
                        name="order_bridge_delivery_note_ids"
                        nolabel="1"
                        readonly="order_bridge_store_state == 'canceled'"
                        context="{'default_author': 'admin'}"
                    >
                        <list editable="bottom" create="true" delete="false">
                            <field name="create_date" string="Fecha" readonly="1" optional="show"/>
                            <field name="author" readonly="1"/>
                            <field name="body" required="1"/>
                            <field name="reviewed" readonly="1" optional="hide"/>
                            <field name="messenger_id" readonly="1" optional="hide"/>
                            <field name="user_id" readonly="1" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_order_tree_order_bridge_store" model="ir.ui.view">
        <field name="name">sale.order.list.order.bridge.store</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="js_class">order_bridge_store_order_list</attribute>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="after">
                <field
                    name="order_bridge_store_state"
                    string="Estado"
                    widget="badge"
                    decoration-muted="order_bridge_store_state == 'reviewing'"
                    decoration-warning="order_bridge_store_state == 'negotiating'"
                    decoration-info="order_bridge_store_state == 'ready_for_delivery'"
                    decoration-success="order_bridge_store_state == 'delivered'"
                    decoration-danger="order_bridge_store_state == 'canceled'"
                />
            </xpath>
            <xpath expr="//field[@name='activity_ids']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id'][@optional='show']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_status']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//list" position="inside">
                <field name="order_bridge_origin" string="Origen"/>
                <field name="order_bridge_messenger_id"/>
                <field
                    name="order_bridge_unread_messenger_note"
                    string="Nota mensajero"
                    widget="boolean"
                    optional="show"
                />
                <field name="order_bridge_device_phone_validated" string="Dispositivo OK"/>
                <field name="order_bridge_partner_has_map_point" string="Coordenadas" widget="boolean"/>
                <field name="order_bridge_ref" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_kanban_order_bridge_store" model="ir.ui.view">
        <field name="name">sale.order.kanban.order.bridge.store</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_kanban"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="js_class">order_bridge_store_order_kanban</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="replace">
                <field
                    name="order_bridge_store_state"
                    widget="badge"
                    decoration-muted="order_bridge_store_state == 'reviewing'"
                    decoration-warning="order_bridge_store_state == 'negotiating'"
                    decoration-info="order_bridge_store_state == 'ready_for_delivery'"
                    decoration-success="order_bridge_store_state == 'delivered'"
                    decoration-danger="order_bridge_store_state == 'canceled'"
                    class="ms-auto"
                />
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_order_bridge" model="ir.ui.view">
        <field name="name">sale.order.list.select.order.bridge</field>
        <field name="model">sale.order</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="after">
                <separator/>
                <filter
                    name="filter_packing"
                    string="Packing"
                    domain="[('order_bridge_store_state', 'in', ('reviewing', 'negotiating'))]"
                />
                <filter
                    name="filter_messenger_notes"
                    string="Notas del mensajero"
                    domain="[('order_bridge_unread_messenger_note', '=', True)]"
                />
            </filter>
        </field>
    </record>
</odoo>
