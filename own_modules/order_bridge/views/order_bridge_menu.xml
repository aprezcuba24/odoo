<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Acciones ──────────────────────────────────────────────── -->

    <record id="action_order_bridge_sale_orders" model="ir.actions.act_window">
        <field name="name">Pedidos</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,calendar,graph,pivot</field>
        <field name="view_id" ref="view_order_tree_order_bridge_store"/>
        <field name="domain">[('order_bridge_origin', '!=', False)]</field>
        <!-- cache=False: evita que el navegador reutilice una acción vieja sin este context -->
        <field name="cache" eval="False"/>
        <field name="context" eval="{'default_order_bridge_origin': 'admin', 'order_bridge_admin_create': True}"/>
        <field name="search_view_id" ref="view_sales_order_filter_order_bridge"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay pedidos desde la tienda.</p>
            <p>Los pedidos creados desde la API externa o marcados como administrador aparecen aquí.</p>
        </field>
    </record>

    <record id="action_order_bridge_sale_orders_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_order_tree_order_bridge_store"/>
        <field name="act_window_id" ref="action_order_bridge_sale_orders"/>
    </record>

    <record id="action_order_bridge_sale_orders_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_order_kanban_order_bridge_store"/>
        <field name="act_window_id" ref="action_order_bridge_sale_orders"/>
    </record>

    <record id="action_order_bridge_partners" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('order_bridge_registered', '=', True)]</field>
        <field name="context">{'default_customer_rank': 1}</field>
        <field name="search_view_id" ref="view_res_partner_filter_order_bridge"/>
    </record>

    <record id="action_order_bridge_whatsapp_publisher" model="ir.actions.client">
        <field name="name">Whatsapp</field>
        <field name="tag">order_bridge_whatsapp_publisher</field>
        <field name="target">current</field>
    </record>

    <!-- ── Menú raíz (aplicación de primer nivel) ───────────────── -->

    <menuitem
        id="menu_order_bridge_root"
        name="Tienda Apk"
        sequence="31"
        web_icon="fa fa-mobile,#FFFFFF,#714B67"
        groups="sales_team.group_sale_salesman,base.group_system"/>

    <!-- ── Pedidos (primer ítem → pantalla de entrada) ──────────── -->

    <menuitem
        id="menu_order_bridge_orders"
        name="Pedidos"
        parent="menu_order_bridge_root"
        action="action_order_bridge_sale_orders"
        sequence="10"
        groups="sales_team.group_sale_salesman"/>

    <!-- ── Clientes ──────────────────────────────────────────────── -->

    <menuitem
        id="menu_order_bridge_clientes_group"
        name="Clientes"
        parent="menu_order_bridge_root"
        sequence="20"
        groups="sales_team.group_sale_salesman"/>

    <menuitem
        id="menu_order_bridge_customers"
        name="Clientes"
        parent="menu_order_bridge_clientes_group"
        action="action_order_bridge_partners"
        sequence="10"
        groups="sales_team.group_sale_salesman"/>

    <menuitem
        id="menu_order_bridge_devices"
        name="Dispositivos"
        parent="menu_order_bridge_clientes_group"
        action="action_order_bridge_device"
        sequence="20"
        groups="sales_team.group_sale_salesman"/>

    <menuitem
        id="menu_order_bridge_messengers"
        name="Mensajeros"
        parent="menu_order_bridge_clientes_group"
        action="action_order_bridge_messenger"
        sequence="30"
        groups="sales_team.group_sale_salesman"/>

    <!-- ── Operaciones ───────────────────────────────────────────── -->

    <menuitem
        id="menu_order_bridge_operaciones_group"
        name="Operaciones"
        parent="menu_order_bridge_root"
        sequence="30"
        groups="sales_team.group_sale_salesman"/>

    <menuitem
        id="menu_order_bridge_whatsapp_publisher"
        name="Whatsapp"
        parent="menu_order_bridge_operaciones_group"
        action="action_order_bridge_whatsapp_publisher"
        sequence="10"
        groups="sales_team.group_sale_salesman"/>

    <menuitem
        id="menu_order_bridge_fcm_send"
        name="Enviar Notificaciones Push"
        parent="menu_order_bridge_operaciones_group"
        action="action_order_bridge_fcm_send_wizard"
        sequence="20"
        groups="sales_team.group_sale_salesman"/>

    <!-- ── Configuración ─────────────────────────────────────────── -->

    <menuitem
        id="menu_order_bridge_config_group"
        name="Configuración"
        parent="menu_order_bridge_root"
        sequence="40"
        groups="sales_team.group_sale_salesman"/>

    <menuitem
        id="menu_order_bridge_general_settings"
        name="Datos generales"
        parent="menu_order_bridge_config_group"
        action="action_order_bridge_general_settings"
        sequence="10"
        groups="order_bridge.group_order_bridge_manager,base.group_system"/>

    <menuitem
        id="menu_order_bridge_categories"
        name="Categorías"
        parent="menu_order_bridge_config_group"
        action="action_order_bridge_product_category"
        sequence="20"
        groups="sales_team.group_sale_salesman"/>

    <menuitem
        id="menu_order_bridge_banners"
        name="Banners publicitarios"
        parent="menu_order_bridge_config_group"
        action="action_order_bridge_banner"
        sequence="30"
        groups="sales_team.group_sale_salesman"/>

    <menuitem
        id="menu_order_bridge_whatsapp_messages"
        name="WhatsApp Mensajes"
        parent="menu_order_bridge_config_group"
        action="action_order_bridge_whatsapp_message"
        sequence="35"
        groups="sales_team.group_sale_salesman"/>

    <menuitem
        id="menu_order_bridge_municipalities"
        name="Municipios"
        parent="menu_order_bridge_config_group"
        action="action_order_bridge_municipality"
        sequence="40"
        groups="sales_team.group_sale_salesman"/>

    <menuitem
        id="menu_order_bridge_neighborhoods"
        name="Barrios"
        parent="menu_order_bridge_config_group"
        action="action_order_bridge_neighborhood"
        sequence="50"
        groups="sales_team.group_sale_salesman"/>
</odoo>
