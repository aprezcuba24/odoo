<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_bridge_transfer_tree" model="ir.ui.view">
        <field name="name">order_bridge.transfer.list</field>
        <field name="model">order_bridge.transfer</field>
        <field name="arch" type="xml">
            <list string="Transferencias" delete="false">
                <field name="create_date" string="Fecha"/>
                <field name="transfer_type"/>
                <field name="code"/>
                <field name="phone"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="currency_id" optional="hide"/>
                <field name="applied"
                    widget="boolean"/>
                <field name="payment_count"/>
                <field name="messenger_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_order_bridge_transfer_form" model="ir.ui.view">
        <field name="name">order_bridge.transfer.form</field>
        <field name="model">order_bridge.transfer</field>
        <field name="arch" type="xml">
            <form string="Transferencia" delete="false">
                <header>
                    <button
                        name="action_apply_to_debt"
                        type="object"
                        string="Aplicar a la deuda"
                        class="btn-primary"
                        invisible="not id or applied or not active"/>
                    <button
                        name="action_discard"
                        type="object"
                        string="Descartar"
                        confirm="La transferencia se ocultará del listado. Podrá recuperarla después. ¿Continuar?"
                        invisible="not id or not active"/>
                    <button
                        name="action_recover"
                        type="object"
                        string="Recuperar"
                        class="btn-primary"
                        invisible="not id or active"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Descartada" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_payments"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-money"
                            invisible="not applied">
                            <field name="payment_count" widget="statinfo" string="Cobros"/>
                        </button>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="id">
                        Al guardar se registra el aviso. Después elija el cliente y
                        pulse «Aplicar a la deuda» para repartir el importe.
                    </div>
                    <group>
                        <group>
                            <field name="transfer_type" readonly="id"/>
                            <field name="code" readonly="id"/>
                            <field name="phone" readonly="id"/>
                            <field name="partner_id" readonly="applied"/>
                            <field name="applied" readonly="1" invisible="not id"/>
                        </group>
                        <group>
                            <field name="amount" readonly="id"/>
                            <field name="currency_id" readonly="id" groups="base.group_multi_currency"/>
                            <field name="messenger_id" readonly="1" invisible="not id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="id"/>
                            <field name="create_date" readonly="1" invisible="not id"/>
                        </group>
                    </group>
                    <notebook invisible="not id">
                        <page string="Cobros" name="payments">
                            <field name="payment_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="order_id"/>
                                    <field name="method_id"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_order_bridge_transfer_search" model="ir.ui.view">
        <field name="name">order_bridge.transfer.search</field>
        <field name="model">order_bridge.transfer</field>
        <field name="arch" type="xml">
            <search string="Transferencias">
                <field name="code"/>
                <field name="phone"/>
                <field name="partner_id"/>
                <field name="messenger_id"/>
                <separator/>
                <filter name="filter_applied" string="Aplicadas" domain="[('applied', '=', True)]"/>
                <filter name="filter_pending" string="Pendientes" domain="[('applied', '=', False)]"/>
                <separator/>
                <filter name="filter_mobile" string="Aviso móvil" domain="[('transfer_type', '=', 'mobile')]"/>
                <separator/>
                <filter name="filter_discarded" string="Descartadas" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_applied" string="Aplicada a deuda" context="{'group_by': 'applied'}"/>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'transfer_type'}"/>
                    <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_order_bridge_transfer_discard_server" model="ir.actions.server">
        <field name="name">Descartar</field>
        <field name="model_id" ref="model_order_bridge_transfer"/>
        <field name="binding_model_id" ref="model_order_bridge_transfer"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_discard()</field>
    </record>

    <record id="action_order_bridge_transfer_recover_server" model="ir.actions.server">
        <field name="name">Recuperar</field>
        <field name="model_id" ref="model_order_bridge_transfer"/>
        <field name="binding_model_id" ref="model_order_bridge_transfer"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_recover()</field>
    </record>

    <record id="action_order_bridge_transfer" model="ir.actions.act_window">
        <field name="name">Transferencias</field>
        <field name="res_model">order_bridge.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_order_bridge_transfer_search"/>
        <field name="context">{'search_default_filter_mobile': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay transferencias registradas.</p>
            <p>
                Registre un aviso con teléfono, importe y código, o revise los enviados
                desde la app móvil. Después asigne el cliente y aplique el importe a su deuda.
            </p>
        </field>
    </record>
</odoo>
