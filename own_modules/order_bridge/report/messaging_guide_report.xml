<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_messaging_guide" model="report.paperformat">
        <field name="name">Guía de mensajería (móvil)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">200</field>
        <field name="page_width">100</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">4</field>
        <field name="margin_bottom">4</field>
        <field name="margin_left">4</field>
        <field name="margin_right">4</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <field name="disable_shrinking" eval="True"/>
    </record>

    <record id="action_report_messaging_guide" model="ir.actions.report">
        <field name="name">Guía de mensajería</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">order_bridge.report_messaging_guide</field>
        <field name="report_file">order_bridge.report_messaging_guide</field>
        <field name="print_report_name">'Guia_mensajeria_%s.pdf' % time.strftime('%Y-%m-%d_%H-%M')</field>
        <field name="binding_model_id" eval="False"/>
        <field name="paperformat_id" ref="paperformat_messaging_guide"/>
    </record>
</odoo>
