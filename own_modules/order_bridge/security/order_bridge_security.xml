<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_order_bridge" model="ir.module.category">
        <field name="name">Tienda Apk</field>
        <field name="description">Gestionar dispositivos cliente de la API y ventas asociadas a la tienda</field>
        <field name="sequence">25</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_order_bridge">
        <field name="name">Tienda Apk</field>
        <field name="category_id" ref="module_category_order_bridge"/>
    </record>

    <record id="group_order_bridge_user" model="res.groups">
        <field name="name">Usuario Tienda Apk</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_order_bridge"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_order_bridge_manager" model="res.groups">
        <field name="name">Responsable Tienda Apk</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_order_bridge"/>
        <field name="implied_ids" eval="[(4, ref('group_order_bridge_user')), (4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <!-- Multi-company record rules -->
    <record id="order_bridge_device_company_rule" model="ir.rule">
        <field name="name">Dispositivo Tienda Apk: multi-company</field>
        <field name="model_id" ref="model_order_bridge_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="order_bridge_banner_company_rule" model="ir.rule">
        <field name="name">Banner Tienda Apk: multi-company</field>
        <field name="model_id" ref="model_order_bridge_banner"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="order_bridge_general_settings_company_rule" model="ir.rule">
        <field name="name">Configuración general Tienda Apk: multi-company</field>
        <field name="model_id" ref="model_order_bridge_general_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="order_bridge_partner_address_company_rule" model="ir.rule">
        <field name="name">Dirección Tienda Apk: multi-company</field>
        <field name="model_id" ref="model_order_bridge_partner_address"/>
        <field name="domain_force">['|', ('partner_id.company_id', '=', False), ('partner_id.company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="order_bridge_push_token_company_rule" model="ir.rule">
        <field name="name">Push token Tienda Apk: multi-company</field>
        <field name="model_id" ref="model_order_bridge_push_token"/>
        <field name="domain_force">[('device_id.company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="order_bridge_order_address_snapshot_company_rule" model="ir.rule">
        <field name="name">Instantánea dirección Tienda Apk: multi-company</field>
        <field name="model_id" ref="model_order_bridge_order_address_snapshot"/>
        <field name="domain_force">[('sale_order_id.company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
